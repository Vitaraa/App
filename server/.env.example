# Copy this file to .env and fill in real values.
# Port the API/server listens on.
PORT=4000
# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=replace-with-a-long-random-secret

# Optional: live stock quotes for investment holdings.
# Get a free key at https://finnhub.io and set it here. If left blank, the app
# falls back to Yahoo Finance's public endpoint (no key, but unofficial).
# The server needs outbound internet access for either to work.
STOCK_API_KEY=

# ---- Email (verification + password reset), via Resend ---------------------
# Sign up at https://resend.com, create an API key, and verify a sending domain.
# If RESEND_API_KEY is left blank, emails are NOT sent — instead the server logs
# the verification/reset link to its console (handy for local testing).
RESEND_API_KEY=
# The "from" address. Must be on a domain you've verified in Resend.
# For quick tests you can use "Claud <onboarding@resend.dev>", which only
# delivers to the email on your own Resend account.
EMAIL_FROM=Claud <onboarding@resend.dev>
# Public base URL of the app, used to build links in emails
# (e.g. https://budget.example.com -> https://budget.example.com/verify?token=...).
# If blank, the server uses the request's own origin.
APP_URL=
