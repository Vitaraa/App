# Copy this file to .env and fill in real values.
# Port the API/server listens on.
PORT=4000
# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=replace-with-a-long-random-secret

# Optional: live stock quotes for investment holdings.
# Get a free key at https://finnhub.io and set it here. If left blank, the app
# falls back to Yahoo Finance's public endpoint (no key, but unofficial).
# The server needs outbound internet access for either to work.
STOCK_API_KEY=
